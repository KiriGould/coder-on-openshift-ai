# Weather MCP server. UBI's Python image already runs as a non-root user in
# GID 0, so restricted-v2's arbitrary UID needs no extra handling.
FROM registry.access.redhat.com/ubi9/python-312:latest

COPY requirements.txt server.py ./
RUN pip install --no-cache-dir -r requirements.txt

ENV PORT=8080
EXPOSE 8080
CMD ["python", "server.py"]
